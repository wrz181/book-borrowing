<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.TodoItemMapper">

    <resultMap id="BaseResultMap" type="TodoItem">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="bizType" column="biz_type"/>
        <result property="bizId" column="biz_id"/>
        <result property="appId" column="app_id"/>
        <result property="receiverId" column="receiver_id"/>
        <result property="status" column="status"/>
        <result property="doneTime" column="done_time"/>
        <result property="createTime" column="create_time"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="appName" column="app_name"/>
    </resultMap>

    <sql id="Todo_With_App_Column_List">
        t.id, t.title, t.content, t.biz_type, t.biz_id, t.app_id, t.receiver_id,
        t.status, t.done_time, t.create_time, t.is_deleted, a.app_name AS app_name
    </sql>

    <sql id="Todo_Query_Where">
        t.is_deleted = 0
        AND t.receiver_id = #{receiverId}
        <if test="status != null">
            AND t.status = #{status}
        </if>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Todo_With_App_Column_List"/>
        FROM todo_item t
        LEFT JOIN integration_app a ON t.app_id = a.id
        <where>
            <include refid="Todo_Query_Where"/>
        </where>
        ORDER BY t.status ASC, t.id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(1)
        FROM todo_item t
        <where>
            <include refid="Todo_Query_Where"/>
        </where>
    </select>

    <select id="countPending" parameterType="long" resultType="long">
        SELECT COUNT(1) FROM todo_item
        WHERE receiver_id = #{receiverId} AND status = 0 AND is_deleted = 0
    </select>

    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Todo_With_App_Column_List"/>
        FROM todo_item t
        LEFT JOIN integration_app a ON t.app_id = a.id
        WHERE t.id = #{id} AND t.is_deleted = 0
    </select>

    <insert id="insert" parameterType="TodoItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (title, content, biz_type, biz_id, app_id, receiver_id, status)
        VALUES (#{title}, #{content}, #{bizType}, #{bizId}, #{appId}, #{receiverId}, 0)
    </insert>

    <update id="markDone">
        UPDATE todo_item SET status = 1, done_time = #{doneTime}
        WHERE id = #{id} AND status = 0 AND is_deleted = 0
    </update>

</mapper>
