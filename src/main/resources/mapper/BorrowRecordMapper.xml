<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.BorrowRecordMapper">

    <!-- 基础结果映射：含关联查询出的图书名称、作者、分类名称 -->
    <resultMap id="BaseResultMap" type="BorrowRecord">
        <id property="id" column="id"/>
        <result property="bookId" column="book_id"/>
        <result property="borrowerName" column="borrower_name"/>
        <result property="borrowerNo" column="borrower_no"/>
        <result property="borrowDate" column="borrow_date"/>
        <result property="dueDate" column="due_date"/>
        <result property="returnDate" column="return_date"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="bookName" column="book_name"/>
        <result property="author" column="author"/>
        <result property="categoryName" column="category_name"/>
    </resultMap>

    <sql id="Record_Column_List">
        r.id, r.book_id, r.borrower_name, r.borrower_no, r.borrow_date, r.due_date,
        r.return_date, r.status, r.remark, r.create_time, r.update_time,
        b.book_name, b.author, c.category_name
    </sql>

    <!--
      动态条件查询：图书名称、借阅人姓名、借阅证号、状态、借阅日期范围，
      各条件均可单独使用，也可组合使用；结果按借阅日期倒序。
    -->
    <sql id="Record_Query_Where">
        <where>
            <if test="query != null">
                <if test="query.bookName != null and query.bookName != ''">
                    AND b.book_name LIKE CONCAT('%', #{query.bookName}, '%')
                </if>
                <if test="query.borrowerName != null and query.borrowerName != ''">
                    AND r.borrower_name LIKE CONCAT('%', #{query.borrowerName}, '%')
                </if>
                <if test="query.borrowerNo != null and query.borrowerNo != ''">
                    AND r.borrower_no LIKE CONCAT('%', #{query.borrowerNo}, '%')
                </if>
                <if test="query.status != null">
                    AND r.status = #{query.status}
                </if>
                <if test="query.beginDate != null and query.endDate != null">
                    AND r.borrow_date BETWEEN #{query.beginDate} AND #{query.endDate}
                </if>
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Record_Column_List"/>
        FROM borrow_record r
        LEFT JOIN book b ON r.book_id = b.id
        LEFT JOIN book_category c ON b.category_id = c.id
        <include refid="Record_Query_Where"/>
        ORDER BY r.borrow_date DESC, r.id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(1)
        FROM borrow_record r
        LEFT JOIN book b ON r.book_id = b.id
        LEFT JOIN book_category c ON b.category_id = c.id
        <include refid="Record_Query_Where"/>
    </select>

    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Record_Column_List"/>
        FROM borrow_record r
        LEFT JOIN book b ON r.book_id = b.id
        LEFT JOIN book_category c ON b.category_id = c.id
        WHERE r.id = #{id}
    </select>

    <insert id="insert" parameterType="BorrowRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO borrow_record (book_id, borrower_name, borrower_no, borrow_date, due_date, return_date, status, remark)
        VALUES (#{bookId}, #{borrowerName}, #{borrowerNo}, #{borrowDate}, #{dueDate}, #{returnDate}, #{status}, #{remark})
    </insert>

    <update id="updateById" parameterType="BorrowRecord">
        UPDATE borrow_record
        SET book_id = #{bookId},
            borrower_name = #{borrowerName},
            borrower_no = #{borrowerNo},
            borrow_date = #{borrowDate},
            due_date = #{dueDate},
            remark = #{remark}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM borrow_record WHERE id = #{id}
    </delete>

    <update id="returnRecord">
        UPDATE borrow_record
        SET return_date = #{returnDate}, status = 2
        WHERE id = #{id} AND status = 1
    </update>

    <!-- R03 重复业务校验：同一借阅人、同一图书、同一借阅日期不得重复生成借阅记录 -->
    <select id="countByBorrowerBookDate" resultType="int">
        SELECT COUNT(1)
        FROM borrow_record
        WHERE book_id = #{bookId}
          AND borrower_no = #{borrowerNo}
          AND borrow_date = #{borrowDate}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <!-- 业务保护：同一借阅人对同一图书不得存在多条未归还记录 -->
    <select id="countUnreturned" resultType="int">
        SELECT COUNT(1)
        FROM borrow_record
        WHERE book_id = #{bookId}
          AND borrower_no = #{borrowerNo}
          AND status = 1
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

</mapper>
