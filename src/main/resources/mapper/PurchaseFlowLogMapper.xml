<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.PurchaseFlowLogMapper">

    <resultMap id="BaseResultMap" type="PurchaseFlowLog">
        <id property="id" column="id"/>
        <result property="flowId" column="flow_id"/>
        <result property="fromNode" column="from_node"/>
        <result property="toNode" column="to_node"/>
        <result property="action" column="action"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="comment" column="comment"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- comment 为 MySQL 关键字（非保留），统一用反引号包裹避免歧义 -->
    <sql id="Base_Column_List">
        id, flow_id, from_node, to_node, `action`, operator_id, operator_name, `comment`, create_time
    </sql>

    <insert id="insert" parameterType="PurchaseFlowLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO purchase_flow_log
            (flow_id, from_node, to_node, `action`, operator_id, operator_name, `comment`)
        VALUES
            (#{flowId}, #{fromNode}, #{toNode}, #{action}, #{operatorId}, #{operatorName}, #{comment})
    </insert>

    <!-- 轨迹按时间正序展示：同一秒内的多条记录用 id 保证先后稳定 -->
    <select id="selectByFlowId" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM purchase_flow_log
        WHERE flow_id = #{flowId}
        ORDER BY create_time ASC, id ASC
    </select>

    <!-- 物理删除：删除草稿/已取消采购单时级联清理该流程的全部轨迹 -->
    <delete id="deleteByFlowId" parameterType="long">
        DELETE FROM purchase_flow_log WHERE flow_id = #{flowId}
    </delete>

</mapper>
