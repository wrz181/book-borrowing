<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.IntegrationFormMapper">

    <resultMap id="BaseResultMap" type="IntegrationForm">
        <id property="id" column="id"/>
        <result property="appId" column="app_id"/>
        <result property="title" column="title"/>
        <result property="formType" column="form_type"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="senderId" column="sender_id"/>
        <result property="senderName" column="sender_name"/>
        <result property="handleTime" column="handle_time"/>
        <result property="handleComment" column="handle_comment"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="appName" column="app_name"/>
    </resultMap>

    <sql id="Form_With_App_Column_List">
        f.id, f.app_id, f.title, f.form_type, f.content, f.status, f.sender_id, f.sender_name,
        f.handle_time, f.handle_comment, f.create_time, f.update_time, f.is_deleted,
        a.app_name AS app_name
    </sql>

    <sql id="Form_Query_Where">
        f.is_deleted = 0
        <if test="appId != null">
            AND f.app_id = #{appId}
        </if>
        <if test="status != null">
            AND f.status = #{status}
        </if>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Form_With_App_Column_List"/>
        FROM integration_form f
        LEFT JOIN integration_app a ON f.app_id = a.id
        <where>
            <include refid="Form_Query_Where"/>
        </where>
        ORDER BY f.id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(1)
        FROM integration_form f
        <where>
            <include refid="Form_Query_Where"/>
        </where>
    </select>

    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Form_With_App_Column_List"/>
        FROM integration_form f
        LEFT JOIN integration_app a ON f.app_id = a.id
        WHERE f.id = #{id} AND f.is_deleted = 0
    </select>

    <insert id="insert" parameterType="IntegrationForm" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO integration_form
            (app_id, title, form_type, content, status, sender_id, sender_name)
        VALUES
            (#{appId}, #{title}, #{formType}, #{content}, #{status}, #{senderId}, #{senderName})
    </insert>

    <update id="updateHandle">
        UPDATE integration_form
        SET status = 1,
            handle_time = #{handleTime},
            handle_comment = #{handleComment}
        WHERE id = #{id} AND is_deleted = 0 AND status = 0
    </update>

</mapper>
