<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.SysRoleMapper">

    <resultMap id="BaseResultMap" type="SysRole">
        <id property="id" column="id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="description" column="description"/>
        <result property="isBuiltin" column="is_builtin"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, role_code, role_name, description, is_builtin, create_time, update_time, is_deleted
        FROM sys_role
        WHERE is_deleted = 0
        ORDER BY id ASC
    </select>

    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT id, role_code, role_name, description, is_builtin, create_time, update_time, is_deleted
        FROM sys_role
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <delete id="deleteRolePermissions" parameterType="long">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="insertRolePermissions">
        INSERT INTO sys_role_permission (role_id, perm_code) VALUES
        <foreach collection="permCodes" item="code" separator=",">
            (#{roleId}, #{code})
        </foreach>
    </insert>

</mapper>
