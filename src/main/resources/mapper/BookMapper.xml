<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.BookMapper">

    <!-- 基础结果映射：含关联查询出的分类名称 -->
    <resultMap id="BaseResultMap" type="Book">
        <id property="id" column="id"/>
        <result property="bookName" column="book_name"/>
        <result property="author" column="author"/>
        <result property="isbn" column="isbn"/>
        <result property="publisher" column="publisher"/>
        <result property="categoryId" column="category_id"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="categoryName" column="category_name"/>
    </resultMap>

    <!--
      一对多关联结果映射（个人指定功能 F2）：
      Book 主对象通过 <collection> 关联其全部借阅记录 borrowRecords。
      注意：借阅记录的状态列起别名为 record_status，避免与图书状态列冲突。
    -->
    <resultMap id="BookDetailResultMap" type="Book" extends="BaseResultMap">
        <collection property="borrowRecords" ofType="BorrowRecord">
            <id property="id" column="record_id"/>
            <result property="borrowerName" column="borrower_name"/>
            <result property="borrowerNo" column="borrower_no"/>
            <result property="borrowDate" column="borrow_date"/>
            <result property="dueDate" column="due_date"/>
            <result property="returnDate" column="return_date"/>
            <result property="status" column="record_status"/>
            <result property="remark" column="remark"/>
        </collection>
    </resultMap>

    <sql id="Book_With_Category_Column_List">
        b.id, b.book_name, b.author, b.isbn, b.publisher, b.category_id,
        c.category_name, b.price, b.stock, b.status, b.create_time, b.update_time
    </sql>

    <!--
      动态条件查询：图书名称、作者、分类、状态四个条件均可单独使用，也可组合使用。
    -->
    <sql id="Book_Query_Where">
        <where>
            <if test="query != null">
                <if test="query.bookName != null and query.bookName != ''">
                    AND b.book_name LIKE CONCAT('%', #{query.bookName}, '%')
                </if>
                <if test="query.author != null and query.author != ''">
                    AND b.author LIKE CONCAT('%', #{query.author}, '%')
                </if>
                <if test="query.categoryId != null">
                    AND b.category_id = #{query.categoryId}
                </if>
                <if test="query.status != null">
                    AND b.status = #{query.status}
                </if>
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Book_With_Category_Column_List"/>
        FROM book b
        LEFT JOIN book_category c ON b.category_id = c.id
        <include refid="Book_Query_Where"/>
        ORDER BY b.id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(1)
        FROM book b
        LEFT JOIN book_category c ON b.category_id = c.id
        <include refid="Book_Query_Where"/>
    </select>

    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Book_With_Category_Column_List"/>
        FROM book b
        LEFT JOIN book_category c ON b.category_id = c.id
        WHERE b.id = #{id}
    </select>

    <!--
      图书详情一对多关联查询（个人指定功能 F2）：
      一条 SQL 关联图书、分类、该图书全部借阅记录，MyBatis 按图书ID自动组装为
      一个 Book 主对象 + List&lt;BorrowRecord&gt; 借阅记录集合。
    -->
    <select id="selectDetailById" parameterType="long" resultMap="BookDetailResultMap">
        SELECT b.id, b.book_name, b.author, b.isbn, b.publisher, b.category_id,
               c.category_name, b.price, b.stock, b.status, b.create_time, b.update_time,
               r.id AS record_id, r.borrower_name, r.borrower_no,
               r.borrow_date, r.due_date, r.return_date, r.status AS record_status, r.remark
        FROM book b
        LEFT JOIN book_category c ON b.category_id = c.id
        LEFT JOIN borrow_record r ON r.book_id = b.id
        WHERE b.id = #{id}
        ORDER BY r.borrow_date DESC
    </select>

    <insert id="insert" parameterType="Book" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book (book_name, author, isbn, publisher, category_id, price, stock, status)
        VALUES (#{bookName}, #{author}, #{isbn}, #{publisher}, #{categoryId}, #{price}, #{stock}, #{status})
    </insert>

    <update id="updateById" parameterType="Book">
        UPDATE book
        SET book_name = #{bookName},
            author = #{author},
            isbn = #{isbn},
            publisher = #{publisher},
            category_id = #{categoryId},
            price = #{price},
            stock = #{stock},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM book WHERE id = #{id}
    </delete>

    <update id="deductStock" parameterType="long">
        UPDATE book SET stock = stock - 1 WHERE id = #{id} AND stock > 0
    </update>

    <update id="addStock" parameterType="long">
        UPDATE book SET stock = stock + 1 WHERE id = #{id}
    </update>

    <select id="countRecordByBookId" parameterType="long" resultType="int">
        SELECT COUNT(1) FROM borrow_record WHERE book_id = #{bookId}
    </select>

</mapper>
