<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookborrowing.mapper.OperationLogMapper">

    <resultMap id="BaseResultMap" type="OperationLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="action" column="action"/>
        <result property="detail" column="detail"/>
        <result property="createTime" column="create_time"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <insert id="insert" parameterType="OperationLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operation_log (user_id, user_name, action, detail)
        VALUES (#{userId}, #{userName}, #{action}, #{detail})
    </insert>

    <select id="selectRecent" resultMap="BaseResultMap">
        SELECT id, user_id, user_name, action, detail, create_time, is_deleted
        FROM operation_log
        WHERE is_deleted = 0
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

</mapper>
